---
// Spielfläche von Mitwachsen: Das Spiel steht für sich, ohne Navigation der Seite. Oben links das Menü für Eltern
// (mit dem Weg zurück zur Startseite), in der Mitte der Name der Figur, rechts die Karte. Auf Touch-Geräten unten ein
// Steuerkreuz. Das Kind spielt sonst mit den Pfeiltasten; eine Aktionstaste gibt es ab 3 nicht. Ohne JavaScript bleibt ein Text für Eltern.
// Wird die Figur müde, erscheint über ihr eine Sprechblase; der Hinweis für Eltern zur Bildschirmzeit kommt beim ersten
// Öffnen und ist über Menü und Sprechblase wieder zu öffnen. Was das Spiel ohne Bild sagt („Noch nicht“ am Eistor),
// meldet eine unsichtbare Live-Region (`mw-say`). Steht die Figur eine Sekunde auf einer Torplatte, blendet oben eine
// Postkarte mit der Front des Tors ein (`mw-card`, nur Bild, unter Kopf, Menü und Steuerkreuz; nicht bei Toren im Norden).
// Dreht in 3D stattdessen die Kamera zur Front, zeigt die genordete Karte einen Blickfächer (`--mw-look`, `--mw-fan`),
// und das Blinzeln zurück dunkelt das Bild kurz ab (`--mw-blink`); beides setzt die 3D-Ansicht (mitwachsen-turn-3d.ts).
// Logik: src/scripts/games/ · Konzept: docs/games/mitwachsen.md
import MitwachsenParentInfo from './MitwachsenParentInfo.astro';
import { HOME_URL } from '../data/site';
---

<larmic-mitwachsen class="mw">
  <div class="mw-top">
    <button type="button" class="pxbtn small mw-btn mw-gear" aria-label="Menü für Eltern">
      <svg width="20" height="20" viewBox="0 0 10 10" shape-rendering="crispEdges" aria-hidden="true">
        <path
          d="M4 0h2v1h1v1h1v1h1v1h1v2h-1v1h-1v1h-1v1h-1v1h-2v-1h-1v-1h-1v-1h-1v-1h-1v-2h1v-1h1v-1h1v-1h1z M4 3v1h-1v2h1v1h2v-1h1v-2h-1v-1z"
          fill="currentColor"
          fill-rule="evenodd"
        ></path>
      </svg>
    </button>
    <div class="mw-name"></div>
    <div class="mw-mapbox">
      <canvas class="mw-map pxbox" role="img" aria-label="Karte mit dem Weg nach Hause"></canvas>
    </div>
  </div>

  <canvas class="mw-canvas3d" aria-hidden="true"></canvas>
  <canvas class="mw-canvas" role="img" aria-label="Spielwelt: eine Figur auf einer Voxel-Insel mit Tieren"></canvas>
  <canvas class="mw-card" aria-hidden="true"></canvas>

  <p class="mw-say sr-only" role="status"></p>

  <div class="mw-bubble pxbox paper" role="status" hidden>
    <div class="mw-bubble-pics" aria-hidden="true">
      <svg class="mw-pic-moon" viewBox="0 0 8 8" shape-rendering="crispEdges">
        <path d="M3 0h3v1h-2v1h-1v4h1v1h3v1h-4v-1h-1v-1h-1v-4h1v-1h1z" fill="#f2c94c"></path>
      </svg>
      <span class="mw-pic-zzz">Zzz</span>
      <svg class="mw-pic-bed" viewBox="0 0 10 7" shape-rendering="crispEdges">
        <path d="M0 0h1v3h9v4h-1v-1h-8v1h-1z" fill="#a0703f"></path>
        <path d="M1 2h3v1h-3z" fill="#e8e2d6"></path>
        <path d="M4 2h5v1h-5z" fill="#5aa6e8"></path>
      </svg>
    </div>
    <p class="mw-bubble-text"></p>
    <button
      type="button"
      class="mw-link mw-bubble-info"
      data-act="info"
      aria-label="Hinweis für Eltern zur Bildschirmzeit"
    >
      i
    </button>
  </div>

  <div class="mw-touch">
    <div class="mw-pad" role="group" aria-label="Laufen">
      <button type="button" class="mw-key mw-key-n" data-dir="n" aria-label="hoch">
        <svg viewBox="0 0 8 8" shape-rendering="crispEdges" aria-hidden="true">
          <path d="M3 1h2v1h1v1h1v1h-6v-1h1v-1h1z M3 4h2v3h-2z" fill="currentColor"></path>
        </svg>
      </button>
      <button type="button" class="mw-key mw-key-w" data-dir="w" aria-label="links">
        <svg viewBox="0 0 8 8" shape-rendering="crispEdges" aria-hidden="true">
          <path d="M3 1h2v1h1v1h1v1h-6v-1h1v-1h1z M3 4h2v3h-2z" fill="currentColor" transform="rotate(-90 4 4)"></path>
        </svg>
      </button>
      <button type="button" class="mw-key mw-key-e" data-dir="e" aria-label="rechts">
        <svg viewBox="0 0 8 8" shape-rendering="crispEdges" aria-hidden="true">
          <path d="M3 1h2v1h1v1h1v1h-6v-1h1v-1h1z M3 4h2v3h-2z" fill="currentColor" transform="rotate(90 4 4)"></path>
        </svg>
      </button>
      <button type="button" class="mw-key mw-key-s" data-dir="s" aria-label="runter">
        <svg viewBox="0 0 8 8" shape-rendering="crispEdges" aria-hidden="true">
          <path d="M3 1h2v1h1v1h1v1h-6v-1h1v-1h1z M3 4h2v3h-2z" fill="currentColor" transform="rotate(180 4 4)"></path>
        </svg>
      </button>
    </div>
  </div>

  <noscript>
    <div class="mw-noscript pxbox paper">
      <p>
        Dieses Spiel für Dreijährige braucht JavaScript. Es läuft ganz im Browser, mit den Pfeiltasten, und ist zum
        gemeinsamen Spielen mit einem Elternteil gedacht.
      </p>
      <MitwachsenParentInfo headingId="mw-info-title-noscript" />
    </div>
  </noscript>

  <dialog class="mw-menu mw-info pxbox paper" aria-labelledby="mw-info-title">
    <MitwachsenParentInfo headingId="mw-info-title" />
    <div class="mw-row">
      <button type="button" class="pxbtn small" data-act="info-close" autofocus>
        Verstanden, los geht's
      </button>
    </div>
  </dialog>

  <dialog class="mw-menu mw-settings pxbox paper" aria-labelledby="mw-menu-title">
    <h2 id="mw-menu-title">Menü für Eltern</h2>

    <section aria-labelledby="mw-worlds-title">
      <h3 id="mw-worlds-title">Welten</h3>
      <ul class="mw-worlds"></ul>
      <button type="button" class="pxbtn small" data-act="new">
        Neue Welt
      </button>
    </section>

    <section aria-labelledby="mw-this-title">
      <h3 id="mw-this-title">Diese Welt</h3>
      <label for="mw-world-name">Name der Welt</label>
      <input id="mw-world-name" type="text" maxlength="16" autocomplete="off" />
      <label for="mw-figure-name">Name der Figur</label>
      <input id="mw-figure-name" type="text" maxlength="16" autocomplete="off" />
      <p class="mw-code-row">
        Welt-Code: <code class="mw-code"></code>
        <button type="button" class="mw-link" data-act="copy">
          Kopieren
        </button>
      </p>
      <p class="mw-hint">Mit dem Code entsteht dieselbe Landschaft, ohne den Spielstand.</p>
    </section>

    <section class="mw-row" aria-label="Einstellungen">
      <button type="button" class="mw-link" data-act="sound" aria-pressed="true">
        Ton ist an
      </button>
      <button type="button" class="mw-link" data-act="motion" aria-pressed="true">
        Kamera bewegen: an
      </button>
      <button type="button" class="mw-link" data-act="cave" aria-pressed="true">
        Höhle dunkel: an
      </button>
      <button type="button" class="mw-link" data-act="fullscreen">
        Vollbild
      </button>
      <button type="button" class="mw-link" data-act="info">
        Für Eltern: Medienzeit
      </button>
    </section>

    <div class="mw-row">
      <button type="button" class="pxbtn small" data-act="close">
        Weiterspielen
      </button>
      <a class="mw-link" href={HOME_URL}>
        Zur Startseite
      </a>
    </div>
  </dialog>
</larmic-mitwachsen>

<style>
  .mw {
    position: relative;
    display: block;
    height: 100vh;
    height: 100dvh;
    min-height: 420px;
    background: linear-gradient(var(--sky-1) 0 33%, var(--sky-2) 33% 66%, var(--sky-3) 66% 100%);
    overflow: hidden;
  }
  /* 2D-Ansicht; mit 3D liegt sie durchsichtig darüber und zeigt nur Zeichen, Pfeil, Nacht und Leiste */
  .mw-canvas,
  .mw-canvas3d {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
  }
  .mw-canvas3d {
    visibility: hidden;
  }
  /* Kein Zoomen, Verschieben oder Markieren durch Kinderhände; das Menü bleibt normal bedienbar */
  .mw-canvas,
  .mw-canvas3d,
  .mw-map,
  .mw-top,
  .mw-touch {
    touch-action: none;
  }
  .mw {
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
  }
  .mw-menu {
    -webkit-user-select: text;
    user-select: text;
  }
  .mw.three .mw-canvas3d {
    visibility: visible;
  }
  /* Blinzeln zurück zur gewohnten Ansicht (300 ms, 3D): das Bild dunkelt ab und wieder auf; Kopf und Menü bleiben */
  .mw::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--ink);
    opacity: var(--mw-blink, 0);
    pointer-events: none;
  }
  /* Postkarte der Torfront: oben mittig unter dem Namen, klein (30 % der Breite, im Querformat flacher), weich ein und aus;
     über der Spielfläche, unter Kopf, Steuerkreuz und Menü (`z-index: 1`) */
  .mw-card {
    position: absolute;
    top: 60px;
    left: 50%;
    width: min(30%, 36vh);
    aspect-ratio: 4 / 3;
    transform: translateX(-50%);
    background: linear-gradient(var(--sky-1), var(--sky-3));
    border: 4px solid var(--paper);
    box-shadow: var(--px-3);
    opacity: 0;
    transition: opacity 250ms linear;
    pointer-events: none;
  }
  .mw-card.on {
    opacity: 1;
  }
  .mw-top {
    position: absolute;
    inset: 12px 12px auto;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    pointer-events: none;
    z-index: 1;
  }
  .mw-top > * {
    pointer-events: auto;
  }
  .mw-gear {
    padding: 0 14px;
  }
  .mw-map {
    display: block;
    width: 168px;
    height: 168px;
    image-rendering: pixelated;
    background: #e4edf3;
  }
  /* Blickfächer: Die Karte bleibt genordet; dreht die 3D-Kamera zur Torfront, zeigt ein Fächer im Ton der Rahmen um
     den Punkt der Figur, wohin sie schaut (`--mw-look` im Uhrzeigersinn von oben); auf Schnee und Gras gleich gut zu sehen */
  .mw-mapbox {
    position: relative;
  }
  .mw-mapbox::after {
    content: '';
    position: absolute;
    inset: 0;
    background: conic-gradient(from calc(var(--mw-look, 0deg) - 25deg), var(--ink) 0 50deg, transparent 0);
    -webkit-mask: radial-gradient(circle, transparent 0 9px, #000 10px 32px, transparent 33px); /* Safari vor 15.4 */
    mask: radial-gradient(circle, transparent 0 9px, #000 10px 32px, transparent 33px);
    opacity: calc(var(--mw-fan, 0) * 0.35);
    pointer-events: none;
  }
  /* Steuerung für Touch: nur auf Geräten ohne Maus (oder nach der ersten Berührung) */
  .mw-touch {
    position: absolute;
    inset: auto 16px 16px;
    display: none;
    justify-content: flex-start;
    align-items: flex-end;
    pointer-events: none;
    z-index: 1;
  }
  .mw.touch .mw-touch {
    display: flex;
  }
  @media (hover: none) and (pointer: coarse) {
    .mw-touch {
      display: flex;
    }
  }
  .mw-pad {
    display: grid;
    grid-template-columns: repeat(3, 56px);
    grid-template-rows: repeat(3, 56px);
    gap: 4px;
  }
  .mw-key {
    pointer-events: auto;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
    color: var(--ink);
    border: 0;
    cursor: pointer;
    box-shadow:
      var(--px-3),
      inset 0 -5px 0 rgba(0, 0, 0, 0.18),
      inset 0 3px 0 rgba(255, 255, 255, 0.5);
  }
  .mw-key {
    display: grid;
    place-items: center;
    padding: 12px;
    background: rgba(255, 253, 247, 0.85);
  }
  .mw-key svg {
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .mw-key:active,
  .mw-key.down {
    transform: translateY(3px);
  }
  .mw-key-n {
    grid-area: 1 / 2;
  }
  .mw-key-w {
    grid-area: 2 / 1;
  }
  .mw-key-e {
    grid-area: 2 / 3;
  }
  .mw-key-s {
    grid-area: 3 / 2;
  }
  .mw-name {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px;
    pointer-events: none;
  }
  .mw-name :global(span) {
    display: grid;
    place-items: center;
    width: 32px;
    height: 34px;
    font-family: var(--font-pixel);
    font-weight: 700;
    font-size: 1.3rem;
    color: var(--ink);
    background: var(--gold);
    box-shadow:
      var(--px-3),
      inset 0 3px 0 var(--gold-light),
      inset 0 -4px 0 var(--gold-dark);
  }
  .mw-noscript {
    position: absolute;
    inset: 50% 16px auto;
    max-width: 520px;
    margin: 0 auto;
    padding: 20px 24px;
    transform: translateY(-50%);
  }
  .mw-menu {
    width: min(460px, calc(100vw - 32px));
    max-height: calc(100dvh - 32px);
    padding: 24px;
    border: 0;
    color: var(--ink);
    overflow: auto;
  }
  .mw-menu::backdrop {
    background: rgba(29, 40, 56, 0.55);
  }
  .mw-menu h2 {
    margin: 0 0 12px;
    font-family: var(--font-pixel);
  }
  .mw-menu h3 {
    margin: 20px 0 8px;
    font-family: var(--font-pixel);
    font-size: 1.1rem;
  }
  .mw-menu section {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-start;
  }
  .mw-menu label {
    font-weight: 800;
    font-size: 0.95rem;
  }
  .mw-menu input {
    width: 100%;
    padding: 8px 10px;
    font: inherit;
    font-family: var(--font-pixel);
    border: 0;
    background: #ffffff;
    box-shadow: var(--px-3);
  }
  .mw-worlds {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mw-worlds :global(li) {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .mw-worlds :global(.mw-delete) {
    flex: none;
    font-size: 0.9rem;
  }
  .mw-worlds :global(.mw-delete[data-armed='1']) {
    color: var(--error);
  }
  .mw-worlds :global(.mw-world) {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    padding: 10px 12px;
    font: inherit;
    text-align: left;
    color: var(--ink);
    background: var(--wood-bg);
    border: 0;
    box-shadow: inset 0 0 0 3px var(--wood-frame);
    cursor: pointer;
  }
  .mw-worlds :global(.mw-world[aria-current='true']) {
    box-shadow: inset 0 0 0 3px var(--ink);
  }
  .mw-worlds :global(.mw-world span) {
    color: var(--muted);
  }
  .mw-code-row {
    margin: 8px 0 0;
  }
  .mw-code {
    margin-right: 10px;
    font-family: var(--font-pixel);
    font-size: 1.1rem;
    letter-spacing: 0.08em;
  }
  .mw-hint {
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .mw-row {
    flex-direction: row !important;
    flex-wrap: wrap;
    gap: 12px 20px !important;
    margin: 20px 0;
  }
  .mw-link {
    padding: 0;
    font: inherit;
    font-weight: 800;
    color: var(--ink);
    text-decoration: underline;
    background: none;
    border: 0;
    cursor: pointer;
  }
  /* Sprechblase über der Figur (die Figur steht in der Bildmitte) */
  .mw-bubble {
    position: absolute;
    left: 50%;
    top: calc(50% - 64px);
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: min(360px, calc(100vw - 32px));
    padding: 12px 16px;
    transform: translate(-50%, -100%);
    pointer-events: none;
  }
  .mw-bubble[hidden] {
    display: none;
  }
  .mw-bubble::after {
    content: '';
    position: absolute;
    left: calc(50% - 8px);
    bottom: -14px;
    width: 16px;
    height: 14px;
    background: inherit;
    clip-path: polygon(0 0, 100% 0, 50% 100%);
  }
  .mw-bubble-pics {
    display: flex;
    align-items: center;
    gap: 6px;
    flex: none;
  }
  .mw-bubble-pics svg {
    width: 32px;
    height: 32px;
  }
  .mw-pic-zzz {
    font-family: var(--font-pixel);
    font-weight: 700;
    color: var(--muted);
  }
  .mw-bubble[data-kind='yawn'] .mw-pic-bed,
  .mw-bubble[data-kind='bed'] .mw-pic-zzz {
    display: none;
  }
  .mw-bubble-text {
    margin: 0;
    font-weight: 800;
  }
  .mw-bubble-info {
    display: none;
    flex: none;
    width: 28px;
    height: 28px;
    font-family: var(--font-pixel);
    text-decoration: none;
    box-shadow: inset 0 0 0 2px var(--ink);
    pointer-events: auto;
  }
  .mw-bubble[data-kind='bed'] .mw-bubble-info {
    display: block;
  }
  .mw-noscript {
    max-height: calc(100dvh - 32px);
    overflow: auto;
  }
  .mw-menu > .pxbtn {
    margin-top: 8px;
  }
  @media (pointer: coarse) {
    .mw {
      min-height: 0;
    }
  }
  /* Handy quer: alles etwas kleiner, damit die Steuerung ganz zu sehen ist */
  @media (max-height: 500px) {
    .mw-map {
      width: 112px;
      height: 112px;
    }
    .mw-pad {
      grid-template-columns: repeat(3, 44px);
      grid-template-rows: repeat(3, 44px);
    }
    .mw-key {
      padding: 9px;
    }
    .mw-touch {
      inset: auto 12px 12px;
    }
  }
  @media (max-width: 560px) {
    .mw-map {
      width: 120px;
      height: 120px;
    }
    .mw-name :global(span) {
      width: 24px;
      height: 26px;
      font-size: 1rem;
    }
  }
  /* Schmales Handy: Die Postkarte reichte unter die Karte oben rechts (12 + 120 px, Schatten 12 px), sie rückt darunter */
  @media (max-width: 430px) {
    .mw-card {
      top: 156px;
    }
  }
</style>

<script>
  import '../scripts/games/larmic-mitwachsen';
  // Die Anmeldung des Service Workers wartet ohnehin aufs Laden der Seite; sie kommt nachgeladen, so bleibt der Kern klein
  void import('../scripts/games/pwa-register').then(
    (m) => m.registerServiceWorker(),
    () => {},
  );
</script>
