---
import PlainPage from '../layouts/PlainPage.astro';
import VoxelIcon from '../components/VoxelIcon.astro';
---

<PlainPage title="Seite nicht gefunden" heading="404 – Seite nicht gefunden" noindex>
  <div class="notfound">
    <div class="notfound-fig">
      <VoxelIcon block="pilz" size={96} />
    </div>
    <p>
      Hier ist noch kein Block gesetzt. <a href="/">Zurück zum Spiel?</a>
    </p>
  </div>
</PlainPage>
